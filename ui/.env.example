# AquaGuard AI Frontend Environment Variables
# Copy this file to .env and fill in the values for your environment.

# Backend API URL (production)
# This should be the full URL to the Render backend WITHOUT /api suffix
# The /api prefix is automatically appended by the frontend code
VITE_API_BASE_URL=https://aquaguard-ai-backend.onrender.com

# For local development, use:
# VITE_API_BASE_URL=http://localhost:8000

# Vite base URL for the frontend app
VITE_BASE_URL=/
